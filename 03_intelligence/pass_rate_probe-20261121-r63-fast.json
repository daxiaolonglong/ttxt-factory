   "evidence_brief": [
    {
     "claim": "提起离婚，很多人第一反应想到的是出轨、家暴、婆媳矛盾这些冲突激烈的问题",
     "first_hand": true,
     "checkable": true,
     "hits": []
    },
    {
     "claim": "过去很长一段时间，婚姻破裂的新闻，大多围绕这些极端矛盾展开",
