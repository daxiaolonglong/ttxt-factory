     "checkable": true,
     "hits": []
    },
    {
     "claim": "但最近民政部门的相关统计和基层婚姻登记处的反馈，出现了一个值得留意的新现象：越来越多刚步入婚姻的00后，选择结束婚姻",
     "first_hand": true,
     "checkable": true,
     "hits": [
      "numbers:00",
