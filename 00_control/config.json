{
  "version": 1,
  "project_root": "D:\\ttxt",
  "strata": {
    "base_url": "http://127.0.0.1:8080",
    "health_path": "/health",
    "models_path": "/v1/models",
    "chat_path": "/v1/chat/completions",
    "request_timeout_s": 600,
    "api_key_env": "STRATA_API_KEY",
    "enable_thinking_default": false,
    "note": "Strata 由用户管理;系统只读取状态与排队调用,绝不启动/停止/重启/切换模型"
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "paths": {
    "control": "00_control",
    "categories": "01_categories",
    "crawler": "02_crawler",
    "intelligence": "03_intelligence",
    "writing": "04_writing",
    "dashboard": "05_dashboard",
    "agents": "06_agents",
    "rules": "07_rules",
    "wiki": "08_wiki",
    "logs": "09_logs",
    "tests": "10_tests",
    "backups": "11_backups",
    "temp": "99_temp",
    "scratch": "07_tmp",
    "assets": "资产库"
  },
  "disk": {
    "project_budget_gb": 20,
    "min_free_gb": 5,
    "temp_max_gb": 2,
    "scratch_max_gb": 2,
    "pip_cache_max_gb": 1,
    "log_max_mb": 10,
    "log_keep": 7,
    "backup_keep": 30,
    "db_max_mb": {
      "system": 200,
      "article": 2048
    },
    "rag_max_mb": 500,
    "browser_max_gb": 3
  },
  "categories": [
    "technology",
    "finance",
    "social",
    "history",
    "health"
  ],
  "crawler": {
    "http_timeout_s": 30,
    "max_attempts": 3,
    "min_delay_s": 1.0,
    "respect_robots": true,
    "user_agent": "TouTiaoSmartFactory/0.1 (+local research collector)"
  },
  "browser": {
    "enabled": true,
    "executable_path": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
    "headless": true,
    "timeout_ms": 60000,
    "network_idle": true,
    "page_pool": 2,
    "disk_cache_mb": 64,
    "_lock_comment": "P36:浏览器 profile 跨进程锁。Worker 与调度进程共用同一份 profile,取不到锁就等待,超过 lock_wait_s 明确报忙(不是假成功)。锁文件在 02_crawler/.browser/profile.lock(profile 目录之外),由操作系统释放,进程被强杀也不会留死锁。",
    "lock_wait_s": 600,
    "lock_poll_s": 2.0
  },
  "model_gate": {
    "poll_interval_s": 2,
    "health_timeout_s": 5,
    "job_timeout_s": 600
  },
  "writing": {
    "gate_min_score": 0.6,
    "gate_min_chars": 400,
    "gate_max_revisions": 2,
    "draft_max_tokens": 900,
    "draft_retry_max_tokens": 2048
  },
  "metrics": {
    "authorized_sources": {
      "toutiao_admin_export": "self_reported",
      "manual_verified": "verified",
      "toutiao_public_article": "public_page"
    },
    "credibility_rank": {
      "verified": 5,
      "self_reported": 4,
      "public_page": 3,
      "public_card": 2,
      "unverified": 1
    },
    "public_pages": {
      "source_id": "toutiao_public_article",
      "hosts": ["www.toutiao.com", "m.toutiao.com"],
      "limit_per_run": 20,
      "sleep_s": 2.0
    }
  },
  "prediction": {
    "min_samples": 5
  },
  "scheduler": {
    "enabled": true,
    "_comment": "P35:metrics_fetch 把公开互动指标自动回流接进闭环(采集→重标定爆款标签→关键词评分→反哺关键词)。它直接用浏览器,而 Worker 是另一个进程、共用同一份 02_crawler/.browser/profile,所以 wait_for_queue_s 先让开队列;排在 crawl_enqueue 之前是有意安排的:同一个 tick 里两个任务都到期时先采指标(此时队列必然空闲),再入队采集。apply=false 是干跑开关,核实过数字才改成 true。P36 之后还有第二道保险:浏览器 profile 跨进程锁,lock_wait_s=300 比 Worker 的 600 短,抢不到就整轮记 skipped_browser_busy 明确跳过(不烧浏览器、不发请求),绝不把 Worker 正在用的浏览器抢过来。",
    "jobs": [
      {"id": "metrics_fetch_6h", "kind": "metrics_fetch", "interval_min": 360, "enabled": true,
       "limit": 12, "sleep_s": 2.5, "apply": true, "retry_gone": false,
       "wait_for_queue_s": 300, "queue_poll_s": 20, "lock_wait_s": 300},
      {"id": "crawl_enqueue_4h", "kind": "crawl_enqueue", "interval_min": 240, "enabled": true},
      {"id": "analyze_daily", "kind": "analyze", "interval_min": 1440, "enabled": true},
      {"id": "recover_daily", "kind": "recover", "interval_min": 1440, "enabled": true},
      {"id": "housekeep_weekly", "kind": "housekeep", "interval_min": 10080, "enabled": true}
    ]
  },
  "supervisor": {
    "_comment": "P31 进程托管:看护 ttxt schedule --daemon 与 ttxt worker。绝不托管 write/publish/model/draft。计划任务每 5 分钟跑一次 `ttxt supervisor --ensure` 兜底拉起,锁空闲才会起新份,不会有两份。",
    "scheduler_interval_s": 300,
    "worker_owner": "supervisor",
    "restart_delay_s": 5.0,
    "max_restarts": 10,
    "window_s": 600.0,
    "poll_s": 1.0,
    "heartbeat_s": 10.0,
    "heartbeat_fresh_s": 900.0
  }
}
